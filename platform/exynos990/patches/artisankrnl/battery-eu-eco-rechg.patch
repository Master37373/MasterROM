+/* batt_full_capacity changed from sysfs */
+void sec_bat_full_capacity_changed(struct sec_battery_info *battery)
+{
+	if (battery->misc_event & BATT_MISC_EVENT_FULL_CAPACITY)
+		sec_bat_recov_full_capacity(battery);
+
+	wake_lock(&battery->monitor_wake_lock);
+	queue_delayed_work(battery->monitor_wqueue, &battery->monitor_work, 0);
+}
+
+/*
+ * Battery protection "eco" recharge (One UI 6.1+, sysfs batt_soc_rechg), ported from
+ * Samsung's sb_full_soc.c: after a full charge, recharge only once the level has
+ * dropped to 95% instead of topping up by voltage.
+ */
+static bool sec_bat_eu_eco_rechg_ui_condition(struct sec_battery_info *battery)
+{
+	if (battery->pdata->recharge_condition_type & SEC_BATTERY_RECHARGE_CONDITION_SOC)
+		return (battery->capacity <= battery->pdata->recharge_condition_soc);
+
+	return false;
+}
+
+static bool sec_bat_check_eu_eco_full_status(struct sec_battery_info *battery)
+{
+	if (!battery->is_eu_eco_rechg ||
+	    battery->status != POWER_SUPPLY_STATUS_FULL) {
+		battery->eu_eco_chg_done = false;
+		return false;
+	}
+
+	if (battery->capacity >= 100) {
+		battery->eu_eco_chg_done = true;
+	} else if (battery->eu_eco_chg_done) {
+		battery->eu_eco_chg_done = false;
+
+		if (battery->is_recharging ||
+		    battery->charging_mode == SEC_BATTERY_CHARGING_2ND) {
+			pr_info("%s: fixed the 2nd fullcharged!!!(%d, %d)\n",
+				__func__, battery->is_recharging, battery->charging_mode);
+			return true;
+		}
+	}
+
+	return false;
+}
+
+static void sec_bat_eu_eco_work(struct work_struct *work)
+{
+	struct sec_battery_info *battery =
+		container_of(work, struct sec_battery_info, eu_eco_work.work);
+	union power_supply_propval value = {0, };
+
+	pr_info("%s: start (%d, %d, %d, %d)\n", __func__,
+		battery->eu_eco_rechg_state, battery->is_eu_eco_rechg,
+		battery->status, battery->capacity);
+
+	mutex_lock(&battery->eu_eco_lock);
+	if (battery->is_eu_eco_rechg == battery->eu_eco_rechg_state)
+		goto end_work;
+
+	if (battery->status != POWER_SUPPLY_STATUS_FULL ||
+	    battery->capacity >= 100)
+		goto update_state;
+
+	if (battery->eu_eco_rechg_state) {
+		pr_info("%s : Update fg scale to %d%%\n", __func__, battery->capacity);
+		value.intval = 99;
+		psy_do_property(battery->pdata->fuelgauge_name, set,
+			POWER_SUPPLY_PROP_CHARGE_FULL, value);
+	} else {
+		sec_bat_set_charging_status(battery, POWER_SUPPLY_STATUS_CHARGING);
+		battery->is_recharging = false;
+		battery->charging_mode = SEC_BATTERY_CHARGING_1ST;
+		sec_bat_set_charge(battery, SEC_BAT_CHG_MODE_CHARGING);
+		pr_info("%s: battery status full -> charging, Cap(%d)\n",
+			__func__, battery->capacity);
+	}
+
+	wake_lock(&battery->monitor_wake_lock);
+	queue_delayed_work(battery->monitor_wqueue, &battery->monitor_work, 0);
+
+update_state:
+	pr_info("%s: update eu eco rechg(%d --> %d)\n", __func__,
+		battery->is_eu_eco_rechg, battery->eu_eco_rechg_state);
+	battery->is_eu_eco_rechg = battery->eu_eco_rechg_state;
+end_work:
+	mutex_unlock(&battery->eu_eco_lock);
+	wake_unlock(&battery->eu_eco_wake_lock);
+}
+
+void sec_bat_eu_eco_set(struct sec_battery_info *battery, bool enable)
+{
+	mutex_lock(&battery->eu_eco_lock);
+	battery->eu_eco_rechg_state = enable;
+	if (enable) {
+		battery->pdata->recharge_condition_type = SEC_BATTERY_RECHARGE_CONDITION_SOC;
+		battery->pdata->recharge_condition_soc = 100 - SEC_BAT_EU_ECO_RECHG_DIF;
+	} else {
+		battery->pdata->recharge_condition_type = battery->old_rechg_cond_type;
+		battery->pdata->recharge_condition_soc = battery->old_rechg_cond_soc;
+	}
+
+	wake_lock(&battery->eu_eco_wake_lock);
+	queue_delayed_work(battery->monitor_wqueue, &battery->eu_eco_work, 0);
+	mutex_unlock(&battery->eu_eco_lock);
+
+	pr_info("%s: set eu eco rechg(%d)\n", __func__, enable);
+}
