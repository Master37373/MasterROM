diff --git a/kernel/selinux/selinux.c b/kernel/selinux/selinux.c
index 258ca819..d784fd6e 100644
--- a/kernel/selinux/selinux.c
+++ b/kernel/selinux/selinux.c
@@ -7,6 +7,32 @@
 #include "klog.h" // IWYU pragma: keep
 #include "ksu.h"
 
+#ifdef CONFIG_KSU_SUSFS
+/*
+ * SuSFS (kernel side in fs/susfs.c and the fs/ hooks) needs to know the
+ * ksu domain and the priv_app domain. They are resolved together with the
+ * KernelSU SID cache, i.e. after the KernelSU rules are in the policy.
+ */
+#define SUSFS_PRIV_APP_CONTEXT "u:r:priv_app:s0:c512,c768"
+
+u32 susfs_ksu_sid __read_mostly = 0;
+u32 susfs_priv_app_sid __read_mostly = 0;
+
+static void susfs_cache_sid(void)
+{
+    if (security_secctx_to_secid(KERNEL_SU_CONTEXT, strlen(KERNEL_SU_CONTEXT), &susfs_ksu_sid))
+        susfs_ksu_sid = 0;
+    if (security_secctx_to_secid(SUSFS_PRIV_APP_CONTEXT, strlen(SUSFS_PRIV_APP_CONTEXT), &susfs_priv_app_sid))
+        susfs_priv_app_sid = 0;
+    pr_info("susfs: ksu sid %u, priv_app sid %u\n", susfs_ksu_sid, susfs_priv_app_sid);
+}
+
+bool susfs_is_current_ksu_domain(void)
+{
+    return unlikely(susfs_ksu_sid && current_sid() == susfs_ksu_sid);
+}
+#endif // #ifdef CONFIG_KSU_SUSFS
+
 /*
  * Cached SID values for frequently checked contexts.
  * These are resolved once at init and used for fast u32 comparison
@@ -208,6 +234,10 @@ void cache_sid(void)
     } else {
         pr_info("Cached ksu_file SID: %u\n", ksu_file_sid);
     }
+
+#ifdef CONFIG_KSU_SUSFS
+    susfs_cache_sid();
+#endif
 }
 
