diff --git a/kernel/hook/setuid_hook.c b/kernel/hook/setuid_hook.c
index 3dddf937..364ef323 100644
--- a/kernel/hook/setuid_hook.c
+++ b/kernel/hook/setuid_hook.c
@@ -25,6 +25,34 @@
 #include "hook/hook_manager.h"
 #include "feature/kernel_umount.h"
 #include "compat/kernel_compat.h"
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/workqueue.h>
+#include <linux/susfs_def.h>
+#include "selinux/selinux.h"
+
+extern struct work_struct susfs_extra_works;
+
+/*
+ * SuSFS: mark a zygote child that KernelSU hides root from (same rules as
+ * kernel_umount: app, webview zygote or isolated process, not allowed for su)
+ * as "umounted". The SuSFS hooks in fs/ only act on such processes. Unlike
+ * the module umount this does not depend on modules being mounted.
+ */
+static void ksu_susfs_mark_umounted(uid_t new_uid)
+{
+    if (!is_appuid(new_uid) && new_uid != WEBVIEW_ZYGOTE_UID && !is_isolated_process(new_uid))
+        return;
+    if (!ksu_uid_should_umount(new_uid) && !is_isolated_process(new_uid))
+        return;
+    if (!is_zygote(current_cred()))
+        return;
+
+    susfs_set_current_proc_umounted();
+    // sus_path_loop entries are flagged again for the new app (deferred, see fs/susfs.c)
+    if (!work_pending(&susfs_extra_works))
+        schedule_work(&susfs_extra_works);
+}
+#endif // #ifdef CONFIG_KSU_SUSFS
 
 int ksu_handle_setresuid(uid_t old_uid, uid_t new_uid)
 {
@@ -69,6 +97,10 @@ int ksu_handle_setresuid(uid_t old_uid, uid_t new_uid)
 #endif
     }
 
+#ifdef CONFIG_KSU_SUSFS
+    ksu_susfs_mark_umounted(new_uid);
+#endif
+
     // Handle kernel umount
     ksu_handle_umount(old_uid, new_uid);
 
