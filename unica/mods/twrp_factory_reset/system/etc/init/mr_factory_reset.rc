service mr_factory_reset /system/bin/mr_factory_reset.sh
    # One UI writes the command file as system:system 0600; run as system so it can be
    # read without root DAC overrides (the domain has no dac_override/dac_read_search).
    user system
    group system cache
    disabled
    oneshot

on property:sys.shutdown.requested=1recovery
    start mr_factory_reset
